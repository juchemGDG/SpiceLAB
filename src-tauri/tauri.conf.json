{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpiceLab",
  "version": "0.1.0",
  "identifier": "de.mint-checker.spicelab",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpiceLab",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Schaltungssimulation für den Unterricht",
    "copyright": "juchemGDG, MIT-Lizenz",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
